{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../frontend",
    "distDir": "../frontend",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "MeowMic Console",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "all": true
      },
      "shell": {
        "all": false,
        "open": true
      },
      "path": {
        "all": true
      },
      "fs": {
        "all": true
      },
      "window": {
        "all": false,
        "startDragging": true,
        "minimize": true,
        "maximize": true,
        "unmaximize": true,
        "close": true
      },
      "process": {
        "all": false,
        "relaunch": true
      },
      "app": {
        "all": true
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://meowmic-update-proxy.siciyuan404.workers.dev/latest.json",
        "https://github.com/siciyuan404/MeowMic/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzNkNDQzcxNTcxRjU5RjAKUldUd1dSOVhjY3hzczZZWElEeldNYmlLRG1tRWJIUlY4Wm4xOU5IUFpJU1VUMjNBVWhGYVROWHcK"
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.meowmic.console",
      "resources": [
        "bin/*"
      ]
    },
    "security": {
      "csp": null
    },
    "systemTray": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "title": "MeowMic"
    },
    "windows": [
      {
        "title": "MeowMic 控制台",
        "width": 752,
        "height": 672,
        "minWidth": 512,
        "minHeight": 592,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ]
  }
}
